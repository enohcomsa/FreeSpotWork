{
  "name": "freespot-university-map-ui",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/freespot/university-map/ui/src",
  "prefix": "free-spot",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["platform:frontend", "product:freespot", "domain:university-map", "layer:ui"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/frontend/freespot/university-map/ui/ng-package.json",
        "tsConfig": "libs/frontend/freespot/university-map/ui/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/frontend/freespot/university-map/ui/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/frontend/freespot/university-map/ui"
      ],
      "options": {
        "coverage.reportsDirectory": "../../../../../coverage/libs/frontend/freespot/university-map/ui"
      }
    }
  }
}
