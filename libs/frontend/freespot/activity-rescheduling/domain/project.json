{
  "name": "freespot-activity-rescheduling-domain",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/freespot/activity-rescheduling/domain/src",
  "prefix": "free-spot",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [
    "platform:frontend",
    "product:freespot",
    "domain:activity-rescheduling",
    "layer:domain"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/frontend/freespot/activity-rescheduling/domain/ng-package.json",
        "tsConfig": "libs/frontend/freespot/activity-rescheduling/domain/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/frontend/freespot/activity-rescheduling/domain/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/frontend/freespot/activity-rescheduling/domain/jest.config.ts",
        "tsConfig": "libs/frontend/freespot/activity-rescheduling/domain/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
