{
  "name": "freespot-academic-schedule-domain",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/freespot/academic-schedule/domain/src",
  "prefix": "free-spot",
  "projectType": "library",
  "tags": ["platform:frontend", "scope:freespot", "type:domain"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/frontend/freespot/academic-schedule/domain/ng-package.json",
        "tsConfig": "libs/frontend/freespot/academic-schedule/domain/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/frontend/freespot/academic-schedule/domain/tsconfig.lib.json"
        },
        "development": {
          "tsConfig": "libs/frontend/freespot/academic-schedule/domain/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/frontend/freespot/academic-schedule/domain/jest.config.ts",
        "tsConfig": "libs/frontend/freespot/academic-schedule/domain/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
