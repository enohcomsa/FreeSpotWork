{
  "name": "freespot-admin-timetabling-feature",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/freespot/admin-timetabling/feature/src",
  "prefix": "free-spot",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [
    "platform:frontend",
    "product:freespot",
    "domain:admin-timetabling",
    "layer:feature",
    "role:leaf"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/frontend/freespot/admin-timetabling/feature/ng-package.json",
        "tsConfig": "libs/frontend/freespot/admin-timetabling/feature/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/frontend/freespot/admin-timetabling/feature/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/frontend/freespot/admin-timetabling/feature/jest.config.ts",
        "tsConfig": "libs/frontend/freespot/admin-timetabling/feature/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
