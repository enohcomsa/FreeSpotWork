{
  "name": "freespot",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "free-spot",
  "sourceRoot": "apps/freespot/src",
  "tags": [
    "platform:frontend",
    "product:freespot",
    "layer:app",
    "role:app-shell"
  ],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "local-dev",
      "options": {
        "outputPath": "dist/apps/freespot",
        "index": "apps/freespot/src/index.html",
        "browser": "apps/freespot/src/main.ts",
        "tsConfig": "apps/freespot/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/freespot/public"
          }
        ],
        "styles": [
          "apps/freespot/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "node_modules/"
          ]
        },
        "scripts": []
      },
      "configurations": {
        "local-dev": {
          "fileReplacements": [
            {
              "replace": "apps/freespot/src/environment/environment.ts",
              "with": "apps/freespot/src/environment/environment.local-dev.ts"
            }
          ],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "dev-atlas": {
          "fileReplacements": [
            {
              "replace": "apps/freespot/src/environment/environment.ts",
              "with": "apps/freespot/src/environment/environment.dev-atlas.ts"
            }
          ],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "e2e": {
          "fileReplacements": [
            {
              "replace": "apps/freespot/src/environment/environment.ts",
              "with": "apps/freespot/src/environment/environment.e2e.ts"
            }
          ],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "staging": {
          "fileReplacements": [
            {
              "replace": "apps/freespot/src/environment/environment.ts",
              "with": "apps/freespot/src/environment/environment.staging.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "575kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/freespot/src/environment/environment.ts",
              "with": "apps/freespot/src/environment/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "575kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "defaultConfiguration": "local-dev",
      "configurations": {
        "local-dev": {
          "buildTarget": "freespot:build:local-dev"
        },
        "dev-atlas": {
          "buildTarget": "freespot:build:dev-atlas"
        },
        "e2e": {
          "buildTarget": "freespot:build:e2e"
        },
        "staging": {
          "buildTarget": "freespot:build:staging"
        },
        "production": {
          "buildTarget": "freespot:build:production"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "freespot:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint/**/*",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ]
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "freespot:build",
        "port": 4200,
        "staticFilePath": "dist/apps/freespot/browser",
        "spa": true
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/apps/freespot"
      ],
      "options": {
        "coverage.reportsDirectory": "../../coverage/apps/freespot"
      }
    }
  }
}
