{
  "name": "freespot-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/freespot-backend/src",
  "projectType": "application",
  "tags": ["platform:backend", "product:freespot", "layer:app"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "freespot-backend:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "freespot-backend:build:development"
        },
        "production": {
          "buildTarget": "freespot-backend:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/apps/freespot-backend"
      }
    }
  }
}
